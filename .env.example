# Backend runtime. Leave credentials blank for health/settings-only local startup.
DATABASE_URL=sqlite:///./agentswarm.db
AUTH_MODE=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
TAVILY_API_KEY=
OPENALEX_API_KEY=
OPENALEX_EMAIL=

MAX_CONCURRENT_SESSIONS=2
MAX_QUEUED_SESSIONS=100
MAX_ACTIVE_SESSIONS_PER_USER=5
MAX_TOTAL_SESSIONS_PER_USER=500
MAX_DOCUMENTS_PER_USER=100
MAX_DOCUMENT_BYTES_PER_USER=524288000
MAX_DOCUMENT_CHARS_PER_USER=50000000
MAX_SELECTED_DOCUMENT_CHARS=8000000
# Live provider connectivity checks are real paid calls and are cooled down.
CONNECTIVITY_COOLDOWN_SECONDS=60
# The combined Docker image is a public reverse proxy. Set AUTH_MODE=supabase
# there; local auth is intentionally refused unless explicitly opted in.
ALLOW_INSECURE_DOCKER_LOCAL_AUTH=0
