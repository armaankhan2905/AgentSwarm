# Backend runtime. Leave credentials blank for health/settings-only local startup.
DATABASE_URL=sqlite:///./agentswarm.db
AUTH_MODE=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Uncomment ONE block. All others should remain commented out.

# --- Option A: Ollama (local, free, no API key required) ---
# Requires: ollama serve && ollama pull qwen2.5:3b
# Reduce MAX_CONCURRENT_SESSIONS to 1 for small local models.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
# PROVIDER_TIMEOUT_SECONDS=120   # default 120 for ollama; raise if your hardware is slow

# --- Option B: Google Gemini (free tier available) ---
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=your-google-ai-studio-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Option C: OpenAI ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your-openai-key
# LLM_BASE_URL=https://api.openai.com/v1

TAVILY_API_KEY=
OPENALEX_API_KEY=
OPENALEX_EMAIL=

MAX_CONCURRENT_SESSIONS=2
MAX_QUEUED_SESSIONS=100
MAX_ACTIVE_SESSIONS_PER_USER=5
MAX_TOTAL_SESSIONS_PER_USER=500
MAX_DOCUMENTS_PER_USER=100
MAX_DOCUMENT_BYTES_PER_USER=524288000
MAX_DOCUMENT_CHARS_PER_USER=50000000
MAX_SELECTED_DOCUMENT_CHARS=8000000
# Live provider connectivity checks are real paid calls and are cooled down.
CONNECTIVITY_COOLDOWN_SECONDS=60
# The combined Docker image is a public reverse proxy. Set AUTH_MODE=supabase
# there; local auth is intentionally refused unless explicitly opted in.
ALLOW_INSECURE_DOCKER_LOCAL_AUTH=0
# The local-auth Docker exception requires both values below exactly. Keep the
# scope isolated and bind the host port to loopback; shared deployments must
# use APP_ENV=production, DEPLOYMENT_SCOPE=shared, and AUTH_MODE=supabase.
APP_ENV=development
DEPLOYMENT_SCOPE=isolated
